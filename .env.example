# Required HPC paths
GLIOMA_PROJECT_ROOT=/path/to/project_workspace
GLIOMA_DATA_ROOT=/path/to/MU-Glioma-Post
GLIOMA_MANIFEST=/path/to/private_mu_manifest.csv

# Required for workflows that load pretraining environments or weights
GLIOMA_PRETRAINING_ROOT=/path/to/pretraining_workspace

# Optional output and temporary roots
GLIOMA_LABEL_ROOT=/path/to/project_workspace/label/MU-Glioma-Post
GLIOMA_LABEL_CONTROL_ROOT=/path/to/project_workspace/label/control_mu_exact_v2
GLIOMA_TMP_ROOT=/tmp/glioma_infiltration
BIOMARKER_OUTPUT_ROOT=/path/to/project_workspace/biomarker_analysis/experiments/MU_5fold_OOF_volume_agreement_v1
